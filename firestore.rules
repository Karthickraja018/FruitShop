rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users/{userId}/products
    // Collection: users/{userId}/juices
    // Collection: users/{userId}/sales
    // Collection: users/{userId}/expenses
    // Collection: users/{userId}/stock
    // Collection: users/{userId}/settings
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }
      match /juices/{juiceId} {
        allow read, write: if isOwner(userId);
      }
      match /sales/{saleId} {
        allow read, write: if isOwner(userId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
      match /stock/{stockId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
